---
import '../styles/global.css';
import { LANGUAGES, translator } from '../i18n';
import { CF_ANALYTICS_TOKEN } from '../config/analytics';

const site = Astro.site ?? new URL('https://example.com');
const t = translator('en');
const choices = LANGUAGES.map((l) => ({ ...l, title: translator(l.code)('choose.title') }));
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <meta name="theme-color" content="#8a1538" />
    <meta name="google-site-verification" content="f-xh61LXdusKHHH0JNYT8wewLdB8DJBkizy1qWDDDIc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {LANGUAGES.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(`/${l.code}/`, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/en/', site).href} />
    {
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    <header class="bg-maroon text-on-maroon">
      <div class="mx-auto max-w-4xl px-4 py-10 sm:py-14">
        <svg width="56" height="39" viewBox="0 0 40 28" aria-hidden="true" class="rounded-[3px] ring-1 ring-white/70">
          <rect width="40" height="28" fill="#8a1538"></rect>
          <path
            d="M0 0h11l5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55H0z"
            fill="#fff"></path>
        </svg>
        <p class="mt-4 text-sm font-semibold text-white/80">{t('site.name')}</p>
        <h1 class="mt-1 text-2xl sm:text-4xl font-bold tracking-tight">{t('meta.title')}</h1>
        <p class="mt-2 max-w-xl text-white/85">{t('site.tagline')}</p>
      </div>
    </header>
    <main class="mx-auto max-w-4xl px-4 py-8">
      <h2 class="text-lg font-bold">Choose your language · اختر لغتك</h2>
      <ul class="mt-4 grid gap-3 grid-cols-1 sm:grid-cols-2" role="list">
        {
          choices.map((l) => (
            <li>
              <a
                href={`/${l.code}/`}
                lang={l.code}
                dir={l.dir}
                hreflang={l.code}
                data-set-lang={l.code}
                data-lang-choice={l.code}
                class="card flex items-center justify-between gap-3 p-4 no-underline text-ink hover:border-maroon"
              >
                <span>
                  <span class="block text-lg font-bold">{l.name}</span>
                  <span class="block text-sm text-muted">{l.title}</span>
                </span>
                <span class="text-xs text-muted" lang="en">
                  {l.englishName}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-sm text-muted">🔒 {t('privacy.badge')}</p>
    </main>
    <script>
      import { savedLanguage } from '../scripts/language-pref';

      // Highlight the saved language, or the browser's preferred one.
      const codes = [...document.querySelectorAll<HTMLElement>('[data-lang-choice]')].map((a) => a.dataset.langChoice!);
      const preferred =
        savedLanguage() ??
        navigator.languages.map((l) => (l.toLowerCase().startsWith('fil') ? 'tl' : l.slice(0, 2).toLowerCase())).find((c) => codes.includes(c));
      const card = preferred ? document.querySelector<HTMLElement>(`[data-lang-choice="${preferred}"]`) : null;
      if (card) {
        card.classList.add('border-maroon');
        card.style.borderWidth = '2px';
        card.parentElement?.parentElement?.prepend(card.parentElement);
      }
    </script>
  </body>
</html>
