---
import '../styles/global.css';
import { LANGUAGES, getLanguage, translator, DICTIONARIES } from '../i18n';
import { RULES } from '../rules/qatar';
import { officialLinks } from '../config/official';
import { CF_ANALYTICS_TOKEN } from '../config/analytics';

interface Props {
  lang: string;
  /** Path after the language prefix, e.g. '' or 'overtime/'. */
  path: string;
  title?: string;
  active?: 'settlement' | 'overtime' | 'privacy';
  /** Extra schema.org objects for this page (e.g. an FAQPage). */
  jsonLd?: Record<string, unknown>[];
}

const { lang, path, title, active, jsonLd = [] } = Astro.props;
const language = getLanguage(lang);
const t = translator(lang);
const site = Astro.site ?? new URL('https://example.com');
const pageTitle = title ? `${title} · ${t('site.name')}` : t('meta.title');
const canonical = new URL(`/${lang}/${path}`, site).href;
const nav = [
  { key: 'settlement', href: `/${lang}/`, label: t('nav.settlement') },
  { key: 'overtime', href: `/${lang}/overtime/`, label: t('nav.overtime') },
  { key: 'sendHome', href: `/${lang}/#send-home`, label: t('nav.sendHome') },
] as const;
const ogImage = new URL('/og-image.png', site).href;
const structuredData = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: t('meta.title'),
    description: t('meta.description'),
    url: canonical,
    inLanguage: lang,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'QAR' },
  },
  ...jsonLd,
]).replaceAll('<', '\\u003c');
const clientData = JSON.stringify({
  lang,
  intl: language.intl,
  homeCurrency: language.homeCurrency,
  lawUrl: officialLinks(lang).law,
  dict: DICTIONARIES[lang],
}).replace(
  /</g,
  '\\u003c',
);
---

<!doctype html>
<html lang={lang} dir={language.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t('meta.description')} />
    <meta name="theme-color" content="#8a1538" />
    <meta name="google-site-verification" content="f-xh61LXdusKHHH0JNYT8wewLdB8DJBkizy1qWDDDIc" />
    <link rel="canonical" href={canonical} />
    {LANGUAGES.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(`/${l.code}/${path}`, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en/${path}`, site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={language.intl.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={structuredData} />
    {
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body class="antialiased">
    <script type="application/json" id="i18n-data" set:html={clientData} />
    <div class="screen-only">
      <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:p-2 focus:bg-surface">Skip to content</a>

      <header class="bg-maroon text-on-maroon">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <div class="flex flex-wrap items-center justify-between gap-3 py-3">
            <a href={`/${lang}/`} class="flex items-center gap-3 no-underline text-on-maroon">
              <svg width="40" height="28" viewBox="0 0 40 28" aria-hidden="true" class="flex-none rounded-[3px] ring-1 ring-white/70 rtl:-scale-x-100">
                <rect width="40" height="28" fill="#8a1538"></rect>
                <path
                  d="M0 0h11l5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55H0z"
                  fill="#fff"></path>
              </svg>
              <span class="flex flex-col leading-tight">
                <span class="text-base sm:text-lg font-bold tracking-tight">{t('site.name')}</span>
                <span class="hidden sm:block text-xs text-white/80 max-w-md">{t('site.tagline')}</span>
              </span>
            </a>
            <div class="flex items-center gap-2">
              <a
                class="gov-pill gov-pill-on-maroon hidden md:inline-flex"
                href={officialLinks(lang).ministry}
                target="_blank"
                rel="noopener noreferrer"
                title={t('verify.newTab')}
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke-linejoin="round"></path>
                  <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                {t('verify.mol')} ↗
              </a>
              <details class="relative">
                <summary
                  class="list-none cursor-pointer select-none rounded-full border border-white/40 px-3 py-1.5 text-sm font-semibold text-on-maroon hover:bg-white/10"
                  aria-label={t('nav.language')}
                >
                  <span aria-hidden="true">🌐</span>
                  {language.name}
                  <span aria-hidden="true" class="ms-1 text-xs text-white/70">▾</span>
                </summary>
                <ul class="absolute end-0 z-20 mt-2 w-56 rounded-xl border border-line bg-white p-1 text-ink shadow-lg" role="list">
                  {
                    LANGUAGES.map((l) => (
                      <li>
                        <a
                          href={`/${l.code}/${path}`}
                          hreflang={l.code}
                          lang={l.code}
                          data-set-lang={l.code}
                          class:list={[
                            'flex items-center justify-between rounded-lg px-3 py-2 no-underline text-ink hover:bg-maroon-tint',
                            l.code === lang && 'bg-maroon-tint font-bold text-maroon',
                          ]}
                          aria-current={l.code === lang ? 'true' : undefined}
                        >
                          <span>{l.name}</span>
                          <span class="text-xs text-muted" lang="en">{l.englishName}</span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </details>
            </div>
          </div>
          <nav class="-mb-px flex gap-5 overflow-x-auto" aria-label="Main">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'whitespace-nowrap border-b-2 pb-2.5 pt-1 text-sm font-semibold no-underline',
                    active === item.key ? 'border-white text-on-maroon' : 'border-transparent text-white/75 hover:text-on-maroon',
                  ]}
                  aria-current={active === item.key ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <p class="mx-auto max-w-6xl px-4 sm:px-6 pt-4 text-xs text-muted">
        <span aria-hidden="true">🔒</span>
        {t('privacy.badge')}
      </p>

      <main id="main" class="mx-auto max-w-6xl px-4 sm:px-6 py-5 sm:py-6">
        <slot />
      </main>

      <footer class="mt-10 bg-maroon text-white/85 pb-16 lg:pb-0">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 py-8 text-sm">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/20 pb-5">
            <span class="flex items-center gap-3 font-bold text-on-maroon">
              <svg width="32" height="22" viewBox="0 0 40 28" aria-hidden="true" class="flex-none rounded-[3px] ring-1 ring-white/70 rtl:-scale-x-100">
                <rect width="40" height="28" fill="#8a1538"></rect>
                <path
                  d="M0 0h11l5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55 5 1.56-5 1.55H0z"
                  fill="#fff"></path>
              </svg>
              {t('site.name')}
            </span>
            <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
              {nav.map((item) => <a href={item.href} class="text-white/85 no-underline hover:text-white">{item.label}</a>)}
              <a href={`/${lang}/privacy/`} class="text-white/85 no-underline hover:text-white">{t('footer.privacy')}</a>
            </nav>
          </div>
          <div class="mt-5 space-y-2">
            <p>{t('footer.disclaimer')}</p>
            <p class="text-white/70">{t('footer.review', { date: RULES.lastLegalReview })}</p>
            {!language.reviewed && <p class="italic text-white/70">{t('footer.translation')}</p>}
          </div>
        </div>
      </footer>
    </div>
    <slot name="print" />
    <script>
      import '../scripts/language-pref';
      import '../scripts/share';
    </script>
  </body>
</html>
