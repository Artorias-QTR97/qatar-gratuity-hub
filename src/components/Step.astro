---
interface Props {
  n: number;
  title: string;
  wrap?: string;
}
const { n, title, wrap } = Astro.props;
---

<fieldset class="card p-4 sm:p-5" data-wrap={wrap}>
  <legend class="sr-only">{title}</legend>
  <div class="mb-4 flex items-center gap-3" aria-hidden="true">
    <span class="step-num num">{n}</span>
    <h3 class="text-base font-bold">{title}</h3>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <slot />
  </div>
</fieldset>
