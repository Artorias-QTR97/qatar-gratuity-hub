---
// One labelled form control with optional hint and an error slot filled by the client script.
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  label: string;
  kind: 'number' | 'date' | 'select' | 'toggle';
  hint?: string;
  prefix?: string;
  min?: number | string;
  max?: number | string;
  step?: number | string;
  value?: string | number;
  placeholder?: string;
  options?: Option[];
  class?: string;
}

const { name, label, kind, hint, prefix, min, max, step, value, placeholder, options = [], class: className } = Astro.props;
const id = `f-${name}`;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
const describedBy = [hint ? hintId : null, errorId].filter(Boolean).join(' ');
---

<div class:list={['field', className]} data-wrap={name}>
  {
    kind === 'toggle' ? (
      <label class="toggle-row" for={id}>
        <input type="checkbox" id={id} name={name} aria-describedby={describedBy} />
        <span class="text-sm font-semibold">{label}</span>
      </label>
    ) : (
      <>
        <label class="field-label" for={id}>
          {label}
        </label>
        {kind === 'select' ? (
          <select class="input" id={id} name={name} aria-describedby={describedBy}>
            {options.map((o) => (
              <option value={o.value} selected={String(value) === o.value}>
                {o.label}
              </option>
            ))}
          </select>
        ) : (
          <div class="relative">
            {prefix && (
              <span class="num pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-xs font-bold text-muted">
                {prefix}
              </span>
            )}
            <input
              class:list={['input num', prefix && 'ps-12']}
              id={id}
              name={name}
              type={kind}
              inputmode={kind === 'number' ? 'decimal' : undefined}
              min={min}
              max={max}
              step={step}
              value={value}
              placeholder={placeholder}
              aria-describedby={describedBy}
              dir="ltr"
            />
          </div>
        )}
      </>
    )
  }
  {hint !== undefined && <p class="hint" id={hintId} data-hint-for={name}>{hint}</p>}
  <p class="error" id={errorId} data-error-for={name} hidden></p>
</div>
