---
// Share the page in the visitor's language. The WhatsApp link works without JavaScript;
// "Copy link" is enhanced by src/scripts/share.ts.
import { translator } from '../i18n';

interface Props {
  lang: string;
  path: string;
  class?: string;
}

const { lang, path, class: className } = Astro.props;
const t = translator(lang);
const url = new URL(`/${lang}/${path}`, Astro.site ?? 'https://example.com').href;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${t('share.message')} ${url}`)}`;
---

<div class:list={['card p-5 sm:flex sm:items-center sm:justify-between sm:gap-6', className]}>
  <p class="font-semibold">{t('share.title')}</p>
  <div class="mt-3 flex flex-wrap gap-2 sm:mt-0 sm:flex-none">
    <a class="btn btn-whatsapp" href={whatsapp} target="_blank" rel="noopener noreferrer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.2z"
        ></path>
      </svg>
      {t('share.whatsapp')}
    </a>
    <button
      type="button"
      class="btn btn-ghost"
      data-copy-link={url}
      data-copied-text={t('share.copied')}
      data-copy-text={t('share.copy')}
    >
      {t('share.copy')}
    </button>
  </div>
</div>
